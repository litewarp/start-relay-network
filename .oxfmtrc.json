{
  "$schema": "https://oxc.rs/schema.json",
  "indentWidth": 2,
  "lineWidth": 100,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/__generated__/**",
    "**/routeTree.gen.ts",
    "**/schema.graphql",
    "**/CHANGELOG.md",
    ".changeset/**",
    "**/dist/**",
    "**/.output/**"
  ]
}
