{
  "name": "@litewarp/start-relay-network",
  "version": "1.0.0-beta.7",
  "description": "TanStack Start adapter for Relay with SSR streaming support",
  "keywords": [
    "relay",
    "tanstack",
    "start",
    "ssr",
    "streaming"
  ],
  "license": "MIT",
  "author": "litewarp",
  "type": "module",
  "imports": {
    "#@/*": "./src/*"
  },
  "files": [
    "dist",
    "README.md",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./transforms/incremental-delivery": {
      "import": "./dist/transforms/incremental-delivery.mjs",
      "types": "./dist/transforms/incremental-delivery.d.mts"
    },
    "./transforms/grafast-relay": {
      "import": "./dist/transforms/grafast-relay.mjs",
      "types": "./dist/transforms/grafast-relay.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/router-core": "^1.170.36",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^16.14.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwind-merge": "^3.7.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/router-core": "^1.170.36",
    "graphql": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  }
}
